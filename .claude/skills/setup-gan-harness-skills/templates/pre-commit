#!/usr/bin/env python3
"""pre-commit — gan-harness gate, the only enforcement point.

Installed by setup-gan-harness-skills into <target>/.git/hooks/pre-commit.
Self-contained — no other harness file invokes this; the project's
generator subagent does NOT run any gate manually. Every `git commit`
attempt fires this hook; non-zero exit aborts the commit.

Behaviour:
    - When specs/_batch/_traces/current-context.json is absent or malformed
      → exit 0 (allow normal maintainer commits outside a live batch).
    - When the file is present with feature + round → run the gate over
      the active stack skill's sensors.ini commands:
          Stage 1 (autofix in place):
              [lint] fix          via stack's sensors.ini
          Stage 2 (read-only verification):
              [lint] check        via stack's sensors.ini
              [typecheck] command via stack's sensors.ini
              [test] unit         via stack's sensors.ini, scope=changed-files
              ac_coverage         INLINE — every AC literal appears in a test
                                  body, eval_anchors string match, and for
                                  `kind: negative` ACs the must_not literal
                                  is paired with an absence-assertion.

Exit codes:
    0  PASS or short-circuit (commit allowed)
    1  any stage FAIL (commit aborted)
    2  script error (sensors.ini missing, stack skill missing, malformed
       feature-list.json) — also aborts the commit because we are inside
       a live batch and cannot verify
"""
from __future__ import annotations

import ast
import configparser
import json
import re
import subprocess
import sys
from pathlib import Path
from typing import Iterable

_BAR = "──────────────────────────────────────────────────────────────"


# ---------------------------------------------------------------------------
# Repo root + short-circuit on absent / malformed context
# ---------------------------------------------------------------------------

def _repo_root() -> Path:
    out = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True, text=True, timeout=5,
    )
    if out.returncode != 0:
        sys.exit(0)
    return Path(out.stdout.strip())


def _read_context(project_dir: Path) -> tuple[str, int] | None:
    ctx_path = project_dir / "specs" / "_batch" / "_traces" / "current-context.json"
    if not ctx_path.is_file():
        return None
    try:
        ctx = json.loads(ctx_path.read_text(encoding="utf-8"))
        feature = str(ctx.get("feature") or "").strip()
        round_int = int(ctx.get("round") or 0)
    except (json.JSONDecodeError, OSError, ValueError):
        return None
    if not feature or round_int <= 0:
        return None
    return feature, round_int


# ---------------------------------------------------------------------------
# sensors.ini reader
# ---------------------------------------------------------------------------

def _read_sensor(stack: Path, section: str, key: str) -> str:
    parser = configparser.ConfigParser(interpolation=None, allow_no_value=True)
    if not parser.read(stack / "sensors.ini", encoding="utf-8"):
        return ""
    if not parser.has_section(section) or not parser.has_option(section, key):
        return ""
    return parser.get(section, key) or ""


def _render_sensor(template: str, **subs: str) -> str:
    out = template
    for k, v in subs.items():
        out = out.replace("{" + k + "}", str(v))
    return out


def _find_stack(project_dir: Path) -> Path | None:
    skills_root = project_dir / ".claude" / "skills"
    if not skills_root.is_dir():
        return None
    for d in sorted(skills_root.iterdir()):
        if d.is_dir() and (d / "sensors.ini").is_file():
            return d
    return None


def _collect_changed_scope(project_dir: Path) -> str:
    """Combined staged + unstaged + untracked changed file list, space-joined."""
    parts: set[str] = set()
    for cmd in (
        ["git", "diff", "--name-only", "--cached"],
        ["git", "diff", "--name-only"],
        ["git", "ls-files", "--others", "--exclude-standard"],
    ):
        try:
            out = subprocess.run(
                cmd, cwd=project_dir, capture_output=True, text=True, timeout=10
            )
        except (subprocess.SubprocessError, OSError):
            continue
        if out.returncode == 0:
            for line in out.stdout.splitlines():
                line = line.strip()
                if line:
                    parts.add(line)
    return " ".join(sorted(parts))


def _run_shell(label: str, cmd: str, project_dir: Path) -> int:
    print()
    print(f"▶ {label}")
    if not cmd or not cmd.strip():
        print("  (skipped: sensors.ini value empty)")
        return 0
    print(f"  $ {cmd}")
    try:
        rc = subprocess.run(cmd, shell=True, cwd=project_dir, timeout=240).returncode
    except subprocess.TimeoutExpired:
        print("  ✗ FAIL (subprocess timeout 240s — check sensors.ini for watch-mode / TTY hangs)")
        return 1
    except (subprocess.SubprocessError, OSError) as exc:
        print(f"  ✗ FAIL (subprocess error: {exc})")
        return 1
    if rc == 0:
        print("  ✓ pass")
        return 0
    print(f"  ✗ FAIL (exit {rc})")
    return rc


# ---------------------------------------------------------------------------
# AC coverage check (inlined; was sensor_ac_coverage.py)
# ---------------------------------------------------------------------------

_TEST_FILE_GLOBS = [
    "test_*.py", "*_test.py",
    "*.test.ts", "*.test.tsx", "*.test.js", "*.test.jsx",
    "*.spec.ts", "*.spec.tsx", "*.spec.js", "*.spec.jsx",
    "*_test.go",
    "*_test.rs",
    "*Test.java",
    "*_test.dart",
]
_NON_PY_TEST_STARTERS = (
    "func Test", "fn test_",
    "void test_", "public void test",
    "it(", "test(", "describe(",
    "@Test",
)
_ABSENCE_MARKERS = (
    "not in",
    "not_in",
    "assert_absent", "assertNotIn", "assertNotEquals", "assertNotContains",
    "findsNothing",
    "toBeFalsy",
    "not.toBe", "not.toEqual", "not.toContain",
    ".not.",
    "to_not",
    "not contain", "doesNotContain",
    "shouldNot",
    "expect_not",
    "isFalse",
    "== false", "!== true", "!= true",
)
_LINE_HASH_COMMENT = re.compile(r"(?m)\s*#[^\n]*$")
_LINE_SLASH_COMMENT = re.compile(r"(?m)//[^\n]*$")
_BLOCK_C_COMMENT = re.compile(r"/\*.*?\*/", re.DOTALL)


def _detect_lang(path: Path) -> str:
    return {
        ".py": "python",
        ".ts": "javascript", ".tsx": "javascript",
        ".js": "javascript", ".jsx": "javascript",
        ".go": "go", ".rs": "rust",
        ".java": "java", ".dart": "dart",
    }.get(path.suffix.lower(), "unknown")


def _strip_comments(src: str, lang: str) -> str:
    if lang == "python":
        return _LINE_HASH_COMMENT.sub("", src)
    src = _LINE_SLASH_COMMENT.sub("", src)
    src = _BLOCK_C_COMMENT.sub("", src)
    src = _LINE_HASH_COMMENT.sub("", src)
    return src


def _find_test_files(roots: Iterable[Path]) -> list[Path]:
    out: list[Path] = []
    for root in roots:
        if root is None or not root.exists():
            continue
        if root.is_file():
            out.append(root)
            continue
        for pat in _TEST_FILE_GLOBS:
            out.extend(root.rglob(pat))
    return sorted({p.resolve() for p in out})


def _python_function_bodies(source: str) -> dict[str, str]:
    try:
        tree = ast.parse(source)
    except SyntaxError:
        return {}
    out: dict[str, str] = {}
    for node in ast.walk(tree):
        if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            continue
        if not node.name.startswith("test_"):
            continue
        try:
            body_src = "\n".join(ast.unparse(n) for n in node.body)
        except Exception:
            body_src = ""
        out[node.name] = f"{node.name}\n{body_src}"
    return out


def _fallback_test_blocks(source: str) -> list[tuple[str, str]]:
    lines = source.splitlines()
    blocks: list[list[str]] = [[]]
    for line in lines:
        stripped = line.lstrip()
        if any(stripped.startswith(s) for s in _NON_PY_TEST_STARTERS):
            blocks.append([line])
        else:
            blocks[-1].append(line)
    out: list[tuple[str, str]] = []
    for i, b in enumerate(blocks):
        if not b:
            continue
        out.append((f"block-{i}", "\n".join(b)))
    return out


def _collect_test_blocks(test_files: list[Path]) -> dict[Path, list[tuple[str, str]]]:
    out: dict[Path, list[tuple[str, str]]] = {}
    for path in test_files:
        try:
            source = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        lang = _detect_lang(path)
        blocks: list[tuple[str, str]] = []
        if lang == "python":
            for name, body in _python_function_bodies(source).items():
                blocks.append((name, _strip_comments(body, "python")))
        else:
            for block_id, body in _fallback_test_blocks(source):
                blocks.append((block_id, _strip_comments(body, lang)))
        out[path] = blocks
    return out


def _ac_id_in_body(ac_id: str, body: str) -> bool:
    return ac_id in body or ac_id.replace("-", "_") in body


def _rel_path(path: Path, project_dir: Path) -> str:
    try:
        return str(path.relative_to(project_dir))
    except ValueError:
        return str(path)


def _format_found_in(blocks: list[tuple[Path, str, str]], project_dir: Path,
                     limit: int = 5) -> str:
    locations = sorted({
        f"{_rel_path(path, project_dir)} :: {block_id}"
        for path, block_id, _ in blocks
    })
    shown = locations[:limit]
    suffix = f" (and {len(locations) - limit} more)" if len(locations) > limit else ""
    return "; ".join(shown) + suffix


def _check_one_ac(ac: dict, test_index: dict[Path, list[tuple[str, str]]],
                  project_dir: Path) -> list[dict]:
    ac_id = ac["id"]
    underscore_variant = ac_id.replace("-", "_")
    missing: list[dict] = []
    blocks_containing_id: list[tuple[Path, str, str]] = []
    for path, blocks in test_index.items():
        for block_id, body in blocks:
            if _ac_id_in_body(ac_id, body):
                blocks_containing_id.append((path, block_id, body))
    if not blocks_containing_id:
        missing.append({
            "ac_id": ac_id, "kind": "ac_id_missing",
            "detail": (
                f"no test function/block contains the literal '{ac_id}' "
                f"(or underscore variant '{underscore_variant}') after stripping comments. "
                f"FIX: write a test whose function name, docstring, or body contains "
                f"'{ac_id}' as a literal string — e.g., `def test_{underscore_variant}_<desc>(...)` "
                f"(Python) or `it('{ac_id}: <desc>', () => ...)` (JS/TS)."
            ),
        })
        return missing
    found_in = _format_found_in(blocks_containing_id, project_dir)
    for anchor in ac.get("eval_anchors", []) or []:
        if not any(anchor in body for _, _, body in blocks_containing_id):
            missing.append({
                "ac_id": ac_id, "kind": "eval_anchor_missing", "anchor": anchor,
                "detail": (
                    f"eval_anchor '{anchor}' must appear inside the SAME test "
                    f"function/block as the AC literal '{ac_id}' (not merely the "
                    f"same file). '{ac_id}' currently lives in: {found_in}. "
                    f"FIX: add the literal string '{anchor}' inside the body of "
                    f"one of those tests."
                ),
            })
    if ac.get("kind") == "negative":
        for must_not in ac.get("must_not", []) or []:
            paired = any(
                must_not in body and any(m in body for m in _ABSENCE_MARKERS)
                for _, _, body in blocks_containing_id
            )
            if not paired:
                missing.append({
                    "ac_id": ac_id, "kind": "must_not_unpaired", "must_not": must_not,
                    "detail": (
                        f"negative AC '{ac_id}': literal '{must_not}' must appear "
                        f"in a test that references '{ac_id}' AND that test must "
                        f"contain a paired absence-assertion (e.g., "
                        f"`assert '{must_not}' not in <output>` Python, or "
                        f"`expect(<output>).not.toContain('{must_not}')` JS/TS). "
                        f"'{ac_id}' currently lives in: {found_in}. "
                        f"FIX: add the literal '{must_not}' AND a not-contains-style "
                        f"assertion inside the body of one of those tests."
                    ),
                })
    return missing


def _stage_ac_coverage(feature: dict, project_dir: Path) -> int:
    print()
    print("▶ Stage 2 / ac_coverage")
    tc = feature.get("test_contract", {}) or {}
    roots: list[Path] = []
    for key in ("l2_path", "l5_smoke_path"):
        v = tc.get(key)
        if v:
            roots.append((project_dir / v).resolve())
    # singleton feature.module_path is gone (deep-module hybrid refactor);
    # walk every spec.module_design[*].module_path entry instead
    for entry in feature.get("spec", {}).get("module_design", []) or []:
        mp = entry.get("module_path")
        if mp:
            roots.append((project_dir / mp).resolve())
    if not roots:
        print("  ✗ FAIL: feature has no l2_path / l5_smoke_path / module_design[*].module_path")
        return 1
    test_files = _find_test_files(roots)
    if not test_files:
        print(f"  ✗ FAIL: no test files matched globs under {[str(r) for r in roots]}")
        return 1
    test_index = _collect_test_blocks(test_files)
    all_missing: list[dict] = []
    for ac in feature.get("spec", {}).get("ac", []) or []:
        all_missing.extend(_check_one_ac(ac, test_index, project_dir))
    if all_missing:
        print(f"  ✗ FAIL ({len(all_missing)} missing across {len(test_files)} test files)")
        for m in all_missing:
            print(f"    - {m.get('ac_id', '-')}: {m['kind']}: {m['detail']}")
        return 1
    print(f"  ✓ pass (scanned {len(test_files)} test files)")
    return 0


def _find_feature(feature_list_path: Path, fid: str) -> dict | None:
    try:
        data = json.loads(feature_list_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    for f in data.get("features", []):
        if f.get("id") == fid:
            return f
    return None


# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

def main() -> int:
    project_dir = _repo_root()
    ctx = _read_context(project_dir)
    if ctx is None:
        return 0  # short-circuit: no live batch
    feature_id, round_int = ctx

    stack = _find_stack(project_dir)
    if stack is None:
        print(f"ERROR: no .claude/skills/<stack>/sensors.ini under {project_dir}",
              file=sys.stderr)
        return 2

    scope = _collect_changed_scope(project_dir)
    feature_list_path = project_dir / "specs" / "_batch" / "feature-list.json"

    print(_BAR)
    print(f"pre-commit gate: feature={feature_id} round={round_int} stack={stack.name}")
    print(_BAR)
    if not scope:
        print("WARN: no changed files detected; running gates with empty scope.")

    overall = 0

    fix_cmd = _render_sensor(_read_sensor(stack, "lint", "fix"), scope=scope)
    rc = _run_shell("Stage 1 / lint.fix", fix_cmd, project_dir)
    if rc != 0:
        print()
        print(_BAR)
        print("pre-commit gate: FAIL (stage 1)")
        print(_BAR)
        return 1

    for label, cmd in (
        ("Stage 2 / lint.check",
         _render_sensor(_read_sensor(stack, "lint", "check"), scope=scope)),
        ("Stage 2 / typecheck",
         _render_sensor(_read_sensor(stack, "typecheck", "command"), scope=scope)),
        ("Stage 2 / test.unit (scope=changed)",
         _render_sensor(_read_sensor(stack, "test", "unit"), scope=scope)),
    ):
        if _run_shell(label, cmd, project_dir) != 0:
            overall = 1

    feature = _find_feature(feature_list_path, feature_id)
    if feature is None:
        print()
        print(f"WARN: {feature_list_path} missing or feature {feature_id} not found; "
              "skipping ac_coverage")
    else:
        if _stage_ac_coverage(feature, project_dir) != 0:
            overall = 1

    print()
    print(_BAR)
    if overall == 0:
        print("pre-commit gate: PASS — commit allowed")
    else:
        print("pre-commit gate: FAIL — commit aborted; fix above and retry")
    print(_BAR)
    return overall


if __name__ == "__main__":
    sys.exit(main())
