# sensors.ini — stack sensor command contract
#
# Annotated template (Python + Ruff + mypy + pytest example).
# Substitute the commands for your stack, validate, and ship at
# .claude/skills/<stack>/sensors.ini.
#
# Placeholder the harness substitutes at invocation time:
#   {scope}  gate_gen_precommit: changed files; gate_eval_postcommit: feature.module_path / l2_path / l5_smoke_path


[lint]
# Stage 1 of gate_gen_precommit (<1s budget). Auto-fix in place; the
# generator commits the fixed files. gate_eval_postcommit does NOT run this
# (no in-place mutation during evaluation).
fix = ruff check --fix --silent {scope}

# Stage 2 of gate_gen_precommit AND L1 of gate_eval_postcommit (<5s budget).
# Read-only; fail loud. No --fix.
check = ruff check {scope}


[typecheck]
# Stage 2 of gate_gen_precommit AND L1 of gate_eval_postcommit. Strict mode is the
# project default per generator-handbook conservative-defaults; loosen
# only with cause.
command = mypy --strict {scope}


[test]
# Unit / component runner. {scope} = changed files (gate_gen_precommit)
# or l2_path (gate_eval_postcommit).
unit = pytest -x --tb=short {scope}

# Optional smoke runner. gate_eval_postcommit uses this only when
# feature.test_contract.l5_smoke_path is non-null. Leave EMPTY to skip
# entirely (gate_eval_postcommit logs SKIPPED, does not error).
smoke = pytest --no-header {scope}
