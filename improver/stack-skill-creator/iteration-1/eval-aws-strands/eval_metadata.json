{
  "eval_id": 1,
  "eval_name": "aws-strands",
  "prompt": "Add AWS Strands Agents (Anthropic-recommended Python framework for building model-driven AI agents — https://strandsagents.com/) as a new stack to gan-harness. Vendor from the official documentation. Scope: Starter (3-5 seed topics).",
  "assertions": [
    {
      "id": "a01",
      "text": "Stack skill SKILL.md exists at .claude/skills/aws-strands/SKILL.md",
      "kind": "file_exists",
      "paths": [".claude/skills/aws-strands/SKILL.md"],
      "blocking": true
    },
    {
      "id": "a02",
      "text": "SKILL.md frontmatter name field is exactly 'aws-strands'",
      "kind": "yaml_frontmatter_contains",
      "paths": [".claude/skills/aws-strands/SKILL.md"],
      "yaml_path": "name",
      "value_regex": "^aws-strands$",
      "blocking": true
    },
    {
      "id": "a03",
      "text": "SKILL.md frontmatter description field is non-empty (≥40 chars)",
      "kind": "yaml_frontmatter_contains",
      "paths": [".claude/skills/aws-strands/SKILL.md"],
      "yaml_path": "description",
      "value_regex": "^.{40,}$",
      "blocking": true
    },
    {
      "id": "a04",
      "text": "references/ has between 4 and 8 .md files total (3-5 topical seeds + upstream.md per Starter scope; mega-file would be 1-2)",
      "kind": "dir_file_count",
      "path_glob": ".claude/skills/aws-strands/references/*.md",
      "min": 4,
      "max": 8,
      "blocking": true
    },
    {
      "id": "a05",
      "text": "references/upstream.md exists (provenance log for web-vendored content)",
      "kind": "file_exists",
      "paths": [".claude/skills/aws-strands/references/upstream.md"],
      "blocking": true
    },
    {
      "id": "a06",
      "text": "references/upstream.md mentions strandsagents.com or aws.amazon.com (the canonical source URLs)",
      "kind": "regex_match",
      "paths": [".claude/skills/aws-strands/references/upstream.md"],
      "regex": "strandsagents\\.com|aws\\.amazon\\.com|github\\.com/strands-agents",
      "blocking": true
    },
    {
      "id": "a07",
      "text": "sensors.ini exists at .claude/skills/aws-strands/sensors.ini (top level, not under references/)",
      "kind": "file_exists",
      "paths": [".claude/skills/aws-strands/sensors.ini"],
      "blocking": true
    },
    {
      "id": "a08",
      "text": "sensors.ini contains [lint] section with both fix and check keys",
      "kind": "regex_match",
      "paths": [".claude/skills/aws-strands/sensors.ini"],
      "regex": "(?s)\\[lint\\].*?fix\\s*=.*?check\\s*=",
      "blocking": true
    },
    {
      "id": "a09",
      "text": "sensors.ini contains [typecheck] section with command key",
      "kind": "regex_match",
      "paths": [".claude/skills/aws-strands/sensors.ini"],
      "regex": "(?s)\\[typecheck\\].*?command\\s*=",
      "blocking": true
    },
    {
      "id": "a10",
      "text": "sensors.ini contains [test] section with unit key",
      "kind": "regex_match",
      "paths": [".claude/skills/aws-strands/sensors.ini"],
      "regex": "(?s)\\[test\\].*?unit\\s*=",
      "blocking": true
    },
    {
      "id": "a11",
      "text": "sensors.ini commands appear stack-appropriate for Python (ruff / mypy / pytest tokens present somewhere)",
      "kind": "regex_match",
      "paths": [".claude/skills/aws-strands/sensors.ini"],
      "regex": "ruff|mypy|pytest",
      "blocking": false
    },
    {
      "id": "a12",
      "text": "SKILL.md has a ## References section listing reference files",
      "kind": "regex_match",
      "paths": [".claude/skills/aws-strands/SKILL.md"],
      "regex": "##\\s+References",
      "blocking": true
    },
    {
      "id": "a13",
      "text": "At least one references/*.md file covers agent / model / tools topic (regex on filenames)",
      "kind": "any_file_exists",
      "paths_glob": [
        ".claude/skills/aws-strands/references/*agent*.md",
        ".claude/skills/aws-strands/references/*model*.md",
        ".claude/skills/aws-strands/references/*tool*.md",
        ".claude/skills/aws-strands/references/*quickstart*.md",
        ".claude/skills/aws-strands/references/*getting*.md"
      ],
      "blocking": true
    },
    {
      "id": "a14",
      "text": "SKILL.md does NOT pre-bake role-specific reference filenames (no sink-module-doc, test-contract, etc.)",
      "kind": "regex_no_match",
      "paths": [".claude/skills/aws-strands/SKILL.md"],
      "regex": "sink-module-doc|test-contract|deep-module-doc",
      "blocking": false
    }
  ]
}
